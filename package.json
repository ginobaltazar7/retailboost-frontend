{
  "name": "retailboost-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "serve -s dist -p $PORT",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "heroku-postbuild": "VITE_API_URL=$VITE_API_URL npm run build"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
